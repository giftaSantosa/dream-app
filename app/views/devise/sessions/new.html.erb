<div class="signin-page" data-controller="signin-landing">
  <div class="signin-hero">
    <div class="landing-copy">
      <h1 class="landing-title">
        Understand your dreams.
      </h1>

      <div class="landing-copy">
        <h1 class="landing-title">
          Understand your dreams.
        </h1>

      <p class="landing-tagline">
        Your dreams, remembered differently.
      </p>
    </div>
  </div>

  <div class="signin-panel">
    <div class="signin-landing-content">
      <button
        type="button"
        class="get-started-button"
        data-action="click->signin-landing#open"
      >
        Get Started
      </button>
    </div>

    <div class="signin-form-content">
      <h2 class="signin-title">Sign in</h2>

      <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <%= f.input :email,
                    label: false,
                    required: false,
                    autofocus: true,
                    placeholder: "Email",
                    wrapper_html: { class: "signin-field" },
                    input_html: {
                      autocomplete: "email",
                      class: "signin-input"
                    } %>

        <%= f.input :password,
                    label: false,
                    required: false,
                    placeholder: "Password",
                    wrapper_html: { class: "signin-field" },
                    input_html: {
                      autocomplete: "current-password",
                      class: "signin-input"
                    } %>

        <div class="signin-options">
          <% if devise_mapping.rememberable? %>
            <%= f.input :remember_me,
                        as: :boolean,
                        label: "Remember me",
                        wrapper_html: { class: "mb-0" } %>
          <% end %>

          <% if devise_mapping.recoverable? %>
            <%= link_to "Forgot your password?",
                        new_password_path(resource_name),
                        class: "signin-forgot" %>
          <% end %>
        </div>

        <div class="signin-actions">
          <%= f.button :submit, "Log in", class: "signin-button" %>
        </div>
      <% end %>

      <div class="signup-omniauth">
        <%- if devise_mapping.omniauthable? %>
          <%- resource_class.omniauth_providers.each do |provider| %>
            <%= button_to "Easy Login with Google",
                          omniauth_authorize_path(resource_name, provider),
                          data: { turbo: false },
                          class: "signup-omniauth-button" %>
          <% end %>
        </div>

      <div class="signin-signup">
        <span>Don't have an account?</span>

        <%= link_to "Sign up here",
                    new_registration_path(resource_name),
                    class: "signin-signup-link" %>
      </div>
    </div>
  </div>
</div>
