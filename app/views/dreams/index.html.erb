<div class="index-background min-vh-100 py-4">
  <div class="container" style="max-width: 500px;">
    <h2 class="mb-4 text-center text-white">Dream History Page</h2>

    <div class="row">
      <div class="col-12">
        <% @dreams.each do |dream| %>
          <%= link_to dream_path(dream), class: "card-link text-decoration-none text-reset" do %>
            <div class="dream-card p-3 mb-3 border-0 rounded-4">
              <div class="d-flex align-items-center">
                <!-- Left Section: Avatar Circle + Text -->
                <div class="d-flex align-items-center gap-3">
                  <div class="rounded-circle bg-light bg-opacity-25 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <span class="fw-bold text-white">A</span>
                  </div>

                  <div>
                    <h6 class="mb-0 fw-bold text-white"><%= dream.title %></h6>
                    <small class="text-white-50">Subhead</small>
                  </div>
                </div>
              </div>
            </div>

          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
