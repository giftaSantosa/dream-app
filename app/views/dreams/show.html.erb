<div class="container">

  <% if @dream.title.present? %>
    <h3><%= @dream.title %></h3>
    <p> mood: <%= @dream.mood %></p>
  <% end %>

  <p><%= @dream.input %></p>

  <p><%= @dream.date.strftime("%B %d, %Y") %></p>

</div>

<div class="container">

  <% if @dream.interpretation.present? %>
    <p><%= @dream.summary %></p>
    <p><%= @dream.theme_list %></p>
    <p><%= @dream.symbol_list %></p>
  <% end %>

</div>
