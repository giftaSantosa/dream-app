<div class="dream-show-wrapper">
  <div class="dream-card">
    <% if @dream.title.present? %>
      <div class="dream-header">
        <h3 class="dream-title">
          <%= @dream.title %>
          <span class="dream-mood"><%= @dream.mood %></span>
        </h3>
        <i class="fa-solid fa-ellipsis-vertical dream-menu-icon"></i>
      </div>
    <% end %>

    <p class="dream-date"><%= @dream.date.strftime("%B %d") %></p>

    <div class="dream-body">
      <p class="dream-input"><%= @dream.input %></p>
    </div>

    <% if @dream.interpretation.present? %>
      <div class="dream-interpretation">
        <p class="dream-summary"><%= @dream.summary %></p>
        <p class="dream-tags"><%= @dream.theme_list %></p>
        <p class="dream-tags"><%= @dream.symbol_list %></p>
      </div>
    <% end %>

  </div>
</div>
