<%= simple_form_for [dream, message] do |f| %>

  <div class="chat-form">

    <%= f.input :content,
        placeholder: "What do you want to know?",
        label: false,
        wrapper_html: {
          class: "chat-input-field"
        },
        input_html: {
          class: "chat-textarea",
          rows: 1
        } %>

    <%= f.button :button,
        type: "submit",
        class: "chat-send-button" do %>

      <i class="fa-solid fa-chevron-right"></i>

    <% end %>

  </div>

<% end %>
