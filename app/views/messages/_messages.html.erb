
<% messages&.each do |message| %>
  <% if message.role == "user" %>
    <div class="d-flex justify-content-end mb-2" data-controller="scroll">
      <div class="bg-primary p-3 rounded-4">
        <%= message.content %>
      </div>
    </div>
  <% elsif message.role == "assistant" %>
    <div class="d-flex justify-content-start mb-5">
      <img src="https://img.magnific.com/free-vector/chatbot-chat-message-vectorart_78370-4104.jpg?semt=ais_hybrid&w=740&q=80"
        class="rounded-circle object-fit-cover me-2"
        style="width: 48px; height: 48px;"
        alt="User Profile">
      <div class="bg-secondary p-3 rounded-4">
        <%= message.content %>
      </div>
    </div>
  <% end %>
<% end %>
