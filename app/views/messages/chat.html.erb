<div class="container" >

  <h1 class="my-5"><%= @dream.title %> Dream Chat </h1>

  <div id="messages">
    <%# messages here %>
    <%= render "messages/messages", messages: @messages %>
  </div>

  <div id="chat-input">
    <%# chat input here %>
    <%= render "messages/chat_input", dream: @dream, message: @message %>
  </div>
</div>
